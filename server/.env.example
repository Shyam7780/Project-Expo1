PORT=5000
MONGO_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/foundit
ML_URL=http://127.0.0.1:8000
PUBLIC_URL=http://localhost:5000

# Deploy ke baad Vercel ka URL (comma se kai URL de sakte ho). Local me * rehne do.
CLIENT_URL=*

# Image storage - inme se EK use karo (dono khali = local uploads folder, sirf local testing ke liye)
# Option A: Cloudinary (free, card nahi chahiye)
CLOUDINARY_URL=
# Option B: AWS S3
AWS_REGION=ap-south-1
AWS_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Support admin page ke liye secret key (kuch bhi lamba random likho)
ADMIN_KEY=change-this-to-a-long-random-string

# ---- Login (Google) ----
# Google Cloud Console se banaya hua OAuth Web Client ID (client me bhi yahi daalna hai)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# Koi bhi lamba random string
JWT_SECRET=change-this-to-a-long-random-secret

# ---- Data auto-delete ----
ITEM_EXPIRY_DAYS=20

# ---- Phone OTP ----
# dev  = OTP screen par dikhega (sirf demo/testing ke liye, SMS nahi jata)
# sms  = Twilio Verify se asli SMS (neeche ke 3 values bharna zaruri)
OTP_MODE=dev
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SID=
